{
  "name": "playgen",
  "version": "1.09",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "test:unit": "pnpm -r --if-present run test:unit",
    "test:integration": "pnpm -r --if-present run test:integration",
    "test:all": "pnpm run test:unit && pnpm run test:integration",
    "test:e2e": "node e2e/run-all.mjs",
    "test:e2e:auth": "node e2e/auth-journey.mjs",
    "test:e2e:stations": "node e2e/stations-journey.mjs",
    "test:e2e:users": "node e2e/users-roles-journey.mjs",
    "test:e2e:library": "node e2e/library-journey.mjs",
    "test:e2e:programs": "node e2e/programs-journey.mjs",
    "test:e2e:scheduler": "node e2e/scheduler-playlist-journey.mjs",
    "test:e2e:analytics": "node e2e/analytics-journey.mjs",
    "test:e2e:dj": "node e2e/dj-journey.mjs",
    "build": "pnpm -r --if-present run build",
    "lint": "eslint 'services/**/*.ts' 'shared/**/*.ts'",
    "typecheck": "pnpm -r --if-present run build",
    "knowledge:init": "tsx tools/knowledge/src/cli.ts init",
    "knowledge:push": "tsx tools/knowledge/src/cli.ts push",
    "knowledge:search": "tsx tools/knowledge/src/cli.ts search",
    "knowledge:seed": "tsx tools/knowledge/src/cli.ts seed"
  },
  "pnpm": {
    "overrides": {
      "tar": ">=7.5.11",
      "esbuild": ">=0.25.0",
      "postcss": ">=8.5.10",
      "fast-xml-parser": ">=5.7.0"
    }
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^8.59.0",
    "eslint": "^9.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0",
    "vite": "^8.0.8"
  }
}
